{
  "name": "osoobe/laravel-promocodes",
  "description": "Laravel 10+ compatible promotion codes generator and validator.",
  "license": "MIT",
  "authors": [
        {
            "name": "Zura Gabievi",
            "email": "zura.gabievi@email.com",
            "homepage": "https://github.com/zgabievi"
        }
    ],
  "homepage": "https://github.com/osoobe/laravel-promocodes",
  "keywords": [
      "Laravel",
      "Promocodes",
      "Coupons",
      "Discounts"
  ],
  "require": {
      "php": "^8.1|^8.2|^8.3",
      "illuminate/support": "^9.0|^10.0|^11.0",
      "illuminate/console": "^9.0|^10.0|^11.0",
      "illuminate/database": "^9.0|^10.0|^11.0",
      "illuminate/broadcasting": "^9.0|^10.0|^11.0",
      "illuminate/queue": "^9.0|^10.0|^11.0",
      "illuminate/container": "^9.0|^10.0|^11.0"
  },
  "require-dev": {
      "phpunit/phpunit": "^10.0",
      "orchestra/testbench": "^8.0|^9.0",
      "pestphp/pest": "^2.0",
      "pestphp/pest-plugin-laravel": "^2.0",
      "pestphp/pest-plugin-mock": "^2.0",
      "nunomaduro/larastan": "^3.0"
  },
  "autoload": {
      "psr-4": {
          "Osoobe\\Promocodes\\": "src/",
          "Osoobe\\Promocodes\\Database\\Factories\\": "database/factories"
      },
      "files": [
          "src/helpers.php"
      ]
  },
  "autoload-dev": {
      "psr-4": {
          "Osoobe\\Promocodes\\Tests\\": "tests/"
      }
  },
  "extra": {
      "laravel": {
          "providers": [
              "Osoobe\\Promocodes\\PromocodesServiceProvider"
          ],
          "aliases": {
              "Promocodes": "Osoobe\\Promocodes\\Facades\\Promocodes"
          }
      }
  },
  "config": {
      "allow-plugins": {
          "pestphp/pest-plugin": true
      }
  },
  "scripts": {
      "test": "./vendor/bin/pest",
      "phpstan": "./vendor/bin/phpstan analyse"
  }
}
